# Modelo de ~/qhos-v2-data/brain/service.env, lido por qhos2-brain.service (EnvironmentFile=).
# O arquivo real fica fora do git (pode ter caminhos e opcoes desta maquina); este modelo tem as mesmas 25 chaves
# do instalado em 29/10/2026, com valores de exemplo seguros: os padroes do codigo (brain_service/config.py,
# codex_chat.py) ou um caminho generico. Nenhum valor foi copiado do arquivo real.
# Instalar: cp service.env.example ~/qhos-v2-data/brain/service.env && chmod 600 ~/qhos-v2-data/brain/service.env
# O que vem do EnvironmentFile vale sobre as linhas Environment= da unit.

# Dados e estado
QHOS2_DATA_ROOT=/home/<usuario>/qhos-v2-data
BRAIN_STATE_DIR=/home/<usuario>/qhos-v2-data/brain/state
BRAIN_RUNTIME_DIR=/home/<usuario>/qhos-v2-data/brain/runtime

# Servico HTTP local (padrao do codigo: 127.0.0.1:8091; origem publica vazia = so local)
BRAIN_SERVICE_HOST=127.0.0.1
BRAIN_SERVICE_PORT=8091
BRAIN_PUBLIC_ORIGIN=https://localhost:8443

# Observacao do coletor da V2 (somente leitura)
BRAIN_QUANT_OBSERVE_URL=http://127.0.0.1:8766
BRAIN_QUANT_WS_ENABLED=false

# Acoes: o Brain da V2 nao religa nada sozinho
BRAIN_CAN_RELIGHT_QUANT=false
BRAIN_AUTO_RELIGHT_QUANT=false
BRAIN_DIAGNOSTICS_ENABLED=true

# Regressao e ciclo (intervalo minimo do teste: 900 s; ciclo minimo: 15 s)
BRAIN_REGRESSION_PROFILE=qhos2-operational-v1
BRAIN_SYSTEMD_UNIT=qhos2-brain.service
BRAIN_SERVICE_CYCLE_S=60
BRAIN_TEST_INTERVAL_S=3600

# Voz (desligada)
BRAIN_VOICE_ENABLED=false
BRAIN_VOICE_URL=http://127.0.0.1:8092

# Chat pelo Codex CLI (0 desliga). O executavel tem de ser caminho absoluto de arquivo regular.
# CODEX_HOME guarda a sessao do Codex: aponte para uma pasta propria, nunca para o git.
BRAIN_CODEX_CHAT=0
BRAIN_CODEX_EXECUTABLE=/home/<usuario>/.local/bin/codex
CODEX_HOME=/home/<usuario>/.codex
BRAIN_CHAT_MODEL=gpt-6-astra
BRAIN_CHAT_EFFORT=medium

# Pastas que o Brain mostra ao operador (somente leitura)
BRAIN_COMPUTER_C=/mnt/c
BRAIN_TRADER_WORKSPACE=/home/<usuario>/qhos-v2
BRAIN_QUANT_DATA_LAKE=/home/<usuario>/qhos-v2-data

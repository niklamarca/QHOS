# ============================================================
# QUANT HPC OS - Environment Variables (copie para .env)
# ============================================================

# LLM - Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Alpaca (Paper Trading + Stocks US)
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Binance (Crypto)
BINANCE_API_KEY=...
BINANCE_SECRET_KEY=...

# Databento Event Plane (desativado ate a fase shadow)
DATABENTO_API_KEY=db-...
EVENT_PLANE_ENABLED=true
DATABENTO_MAX_REQUEST_USD=5.0
EVENT_PLANE_MAX_RECORDS_PER_REQUEST=1000000
DATABENTO_BOOTSTRAP_SHADOW=true
DATABENTO_SHADOW_DATASET=EQUS.MINI
DATABENTO_SHADOW_SCHEMA=ohlcv-1m
DATABENTO_SHADOW_SYMBOL=SPY
DATABENTO_SHADOW_USE_QHOS_UNIVERSE=true
DATABENTO_SHADOW_LIMIT=50000
DATABENTO_BOOTSTRAP_MAX_USD=0.25
DATABENTO_SHADOW_POLL_MINUTES=60

# IBKR (Futuros - opcional)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# System Config
SYSTEM_MODE=research
LOG_LEVEL=INFO
DASHBOARD_PORT=8000
MAX_CPU_THREADS=32
GPU_DEVICE=cuda:0

# Risk Limits Globais
MAX_PORTFOLIO_DRAWDOWN=0.10
MAX_POSITION_SIZE=0.05
MAX_DAILY_LOSS=0.02
RISK_FREE_RATE=0.05
